{
  "name": "s4_extensao_dotz",
  "version": "1.7.4",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --require tsconfig-paths/register src/index.ts",
    "dev:workers": "ts-node-dev --respawn --transpile-only --require tsconfig-paths/register src/queue/workers.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "start:workers": "node dist/queue/workers.js",
    "prisma:generate": "npm run prisma:generate:s4 && npm run prisma:generate:stage && npm run prisma:generate:relatorio-readonly",
    "prisma:generate:s4": "prisma generate --schema=./prisma/s4_extensao_dotz/schema.prisma",
    "prisma:generate:stage": "prisma generate --schema=./prisma/dotz-stage/schema.prisma",
    "prisma:generate:relatorio-readonly": "prisma generate --schema=./prisma/relatorio-readonly/schema.prisma",
    "prisma:studio:s4": "prisma studio --schema=./prisma/s4_extensao_dotz/schema.prisma",
    "prisma:studio:stage": "prisma studio --schema=./prisma/dotz-stage/schema.prisma",
    "prisma:migrate:s4": "prisma migrate dev --schema=./prisma/s4_extensao_dotz/schema.prisma",
    "prisma:migrate:deploy:s4": "prisma migrate deploy --schema=./prisma/s4_extensao_dotz/schema.prisma",
    "prisma:pull:stage": "prisma db pull --schema=./prisma/dotz-stage/schema.prisma",
    "prisma:pull:s4": "prisma db pull --schema=./prisma/s4_extensao_dotz/schema.prisma",
    "prisma:seed:s4": "ts-node --require tsconfig-paths/register prisma/s4_extensao_dotz/seed.ts",
    "prisma:seed:stage": "ts-node --require tsconfig-paths/register prisma/dotz-stage/seed.ts",
    "prisma:migrate:reset:s4": "prisma migrate reset --schema=./prisma/s4_extensao_dotz/schema.prisma",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:ui": "vitest --config vitest.config.ts --ui",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:coverage:unit": "vitest run --config vitest.config.ts --coverage",
    "test:integration": "dotenv -e .env.test -- vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "dotenv -e .env.test -- vitest --config vitest.integration.config.ts",
    "test:integration:ui": "dotenv -e .env.test -- vitest --config vitest.integration.config.ts --ui",
    "test:integration:coverage": "dotenv -e .env.test -- vitest run --config vitest.integration.config.ts --coverage",
    "test:integration:external": "cross-env RUN_EXTERNAL_INTEGRATION_TESTS=true dotenv -e .env.test.external -- vitest run --config vitest.integration.config.ts",
    "test:coverage:all": "npm run test:coverage:unit && npm run test:integration:coverage",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f docker-compose.test.yml down",
    "db:test:nuke": "docker compose -f docker-compose.test.yml down -v",
    "db:test:migrate": "dotenv -e .env.test -- prisma migrate deploy --schema=./prisma/s4_extensao_dotz/schema.prisma",
    "db:test:reset": "dotenv -e .env.test -- prisma migrate reset --force --schema=./prisma/s4_extensao_dotz/schema.prisma",
    "cli": "ts-node --require tsconfig-paths/register src/cli/index.ts",
    "deploy": "node scripts/deploy.js",
    "logs": "node scripts/logs.js"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.28.0",
    "@google-cloud/storage": "^7.19.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.16.3",
    "@react-email/components": "^0.5.5",
    "amqplib": "^0.10.9",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "commander": "^14.0.3",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "cron-parser": "^4.9.0",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.1",
    "dotenv": "^16.0.3",
    "elastic-apm-node": "^4.15.0",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.0",
    "libphonenumber-js": "^1.12.34",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.10",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-elasticsearch": "^0.19.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "@types/amqplib": "^0.10.7",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.7.0",
    "@types/nodemailer": "^7.0.3",
    "@types/react": "^19.1.13",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^10.0.0",
    "mssql": "^11.0.1",
    "msw": "^2.13.3",
    "prisma": "^6.16.3",
    "ssh2": "^1.17.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "ts-node prisma/s4_extensao_dotz/seed.ts"
  }
}
