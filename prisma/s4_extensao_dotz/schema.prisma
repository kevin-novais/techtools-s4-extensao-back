// Status Novo: PENDENTE, INTEGRADO_SAP, INTEGRADO_VEXPENSES, ERRO_INTEGRACAO_SAP, ERRO_INTEGRACAO_VEXPENSES

// Status Antigo:
// 1: Nota criada no SAP
// 2: Erro na importacao
// 3: Pagamento enviado ao VExpenses
// 4: Erro ao enviar pagamento 

model ControleExpense{
    id Int @id @default(autoincrement()) @map("id")
    reportId Int @map("report_id")
    paying_company_id Int? @map("paying_company_id") /// Anulavel: relatorios descartados antes da integracao podem nao ter empresa pagadora resolvida

    status String @map("status") @db.NVarChar(50) @default("PENDENTE") /// Status Novo: PENDENTE, INTEGRADO_SAP, INTEGRADO_VEXPENSES, ERRO_INTEGRACAO_SAP, ERRO_INTEGRACAO_VEXPENSES, DESCARTADO
    codigoDocumentoERP String? @map("codigo_documento_erp") @db.NVarChar(50) /// Vem do SAP
    codigoCia String? @map("codigo_cia") @db.NVarChar(4) /// CompanyCode SAP do documento (chave da baixa: company_code+fiscal_year+accounting_document)
    fiscalYear String? @map("fiscal_year") @db.NVarChar(4) /// Ano fiscal do lancamento; compoe a chave da baixa
    codigoSapColaborador String? @map("codigo_sap_colaborador") @db.NVarChar(50) /// Vem do vExpenses
    codigoProtocoloVexpenses String? @map("codigo_protocolo_vexpenses") @db.NVarChar(50) /// Vem do vExpenses
    error_message String? @map("error_message") @db.NVarChar(1000)
    request String? @map("request") @db.NVarChar(Max) /// Payload JSON enviado ao SAP
    response String? @map("response") @db.NVarChar(Max) /// Resposta do SAP (sucesso ou erro)
    nomeColaborador String? @map("nome_colaborador") @db.NVarChar(200) /// Nome do colaborador (team-member VExpenses)
    valorDocumento Decimal? @map("valor_documento") @db.Decimal(19,2) /// Valor total do lançamento SAP


    dataImportacao DateTime? @map("data_importacao")
    dataIntegracaoPagamento DateTime? @map("data_integracao_pagamento")
    dataAprovacao DateTime? @map("data_aprovacao")

    criadoEm DateTime @default(now()) @map("criado_em")
    atualizadoEm DateTime @default(now()) @map("atualizado_em")

    @@map("controle_expense")
}

