/**
 * Receitas diferidas (Fluxo 5) — uma linha por parcela futura por venda.
 * status: PENDENTE, INTEGRADO, ERRO_INTEG, REVERSAO_PENDENTE, REVERTIDO, ERRO_REVERT
 */
model VendaRecDiferida {
    id Int @id @default(autoincrement()) @map("id")

    vendasHeaderId Int @map("vendas_header_id")

    periodoDiferimento Int @map("periodo_diferimento") @db.SmallInt /// Sequência 1 a 48 (único junto com vendas_header_id)
    tipo               String @default("DIFERIDO_TOTAL") @map("tipo") @db.VarChar(25)
    status             String @default("PENDENTE") @map("status") @db.NVarChar(20)

    ano Int? @map("ano") /// Ano em que o documento foi cadastrado no SAP (sequência reinicia por ano)

    dataEmissao     DateTime? @map("data_emissao") @db.Date /// Data de emissão do documento de origem
    dataDiferimento DateTime? @map("data_diferimento") @db.Date /// Competência (futura) do reconhecimento

    valorDiferimento Decimal? @map("valor_diferimento") @db.Decimal(15, 2)

    tipoContabilErp  String? @map("tipo_contabil_erp") @db.NVarChar(20) /// Ex.: GL
    tipoDocumentoErp String? @map("tipo_documento_erp") @db.NVarChar(5) /// Ex.: RD

    contaCredito String? @map("conta_credito") @db.NVarChar(20)
    contaDebito  String? @map("conta_debito") @db.NVarChar(20)

    centroLucro  String? @map("centro_lucro") @db.NVarChar(20)
    centroCusto  String? @map("centro_custo") @db.NVarChar(20)

    anoFiscalLancamento Int?      @map("ano_fiscal_lancamento") /// Ano fiscal do lançamento SAP
    dataIntegracao      DateTime? @map("data_integracao") @db.DateTime2
    codigoDocumentoErp  String? @map("codigo_documento_erp") @db.NVarChar(20)
    requestSap          String? @map("request_sap") @db.NVarChar(Max)
    responseSap         String? @map("response_sap") @db.NVarChar(Max)

    tipoContabilErpReversao  String? @map("tipo_contabil_erp_reversao") @db.NVarChar(20)
    tipoDocumentoErpReversao String? @map("tipo_documento_erp_reversao") @db.Char(5)
    contaCreditoReversao     String? @map("conta_credito_reversao") @db.NVarChar(20)
    contaDebitoReversao      String? @map("conta_debito_reversao") @db.NVarChar(20)
    centroLucroReversao      String? @map("centro_lucro_reversao") @db.NVarChar(20)
    centroCustoReversao      String? @map("centro_custo_reversao") @db.NVarChar(20)
    codigoDocumentoErpReversao String? @map("codigo_documento_erp_reversao") @db.NVarChar(20)

    anoReversao                  Int?      @map("ano_reversao") /// Ano fiscal do lançamento SAP de reversão
    dataDoLancamentoDaReversao DateTime? @map("data_do_lancamento_da_reversao") @db.Date

    aliquotaPis    Decimal? @map("aliquota_pis") @db.Decimal(7, 4)
    aliquotaCofins Decimal? @map("aliquota_cofins") @db.Decimal(7, 4)
    valorPis       Decimal? @map("valor_pis") @db.Decimal(19, 6)
    valorCofins    Decimal? @map("valor_cofins") @db.Decimal(19, 6)
    mensagemErro   String?  @map("mensagem_erro") @db.NVarChar(Max)

    criadoEm     DateTime @default(now()) @map("criado_em")
    atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

    vendasHeader VendasHeader @relation(fields: [vendasHeaderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

    @@unique([vendasHeaderId, periodoDiferimento, tipo])
    @@index([status], map: "idx_venda_rec_diferida_status")
    @@index([dataDiferimento], map: "idx_venda_rec_diferida_data_dif")
    @@index([vendasHeaderId], map: "idx_venda_rec_diferida_header_id")
    @@index([ano], map: "idx_venda_rec_diferida_ano")
    @@map("venda_rec_diferida")
}

// =====================================================================
// XTPG Envio (integração DeepXRT) - Logs de envio Previsto e Realizado
// HEADER = 1 requisição (lote) enviada à XTPG (request = payload SOAP completo).
// DETAIL = 1 movimento por linha, com o espelho completo do que foi enviado
//          + status individual + id_xrt/erro retornados por registro.
// criado_por / atualizado_por: id do usuário ou 0 (processo/cron de sistema).
// Sem FK para usuarios pois os registros são gerados por processo automático.
// =====================================================================

model XtpgEnvioPrevistoHeader {
    id             Int      @id @default(autoincrement())
    status         String   @default("PROCESSANDO") @map("status") @db.NVarChar(20) /// PROCESSANDO | ENVIADO | PARCIAL | ERRO
    totalRegistros Int      @default(0) @map("total_registros") /// Qtd de DETAIL (movimentos) no lote
    request        String?  @map("request") @db.NVarChar(Max) /// Payload SOAP completo enviado
    response       String?  @map("response") @db.NVarChar(Max) /// Resposta SOAP bruta da XTPG
    mensagemErro   String?  @map("mensagem_erro") @db.NVarChar(Max) /// Erro de transporte/lote (quando aplicável)

    criadoEm      DateTime @default(now()) @map("criado_em")
    criadoPor     Int      @default(0) @map("criado_por")
    atualizadoEm  DateTime @default(now()) @updatedAt @map("atualizado_em")
    atualizadoPor Int      @default(0) @map("atualizado_por")

    detalhes XtpgEnvioPrevistoDetail[]

    @@index([status])
    @@index([criadoEm])
    @@map("xtpg_envio_previsto_header")
}

model XtpgEnvioPrevistoDetail {
    id       Int @id @default(autoincrement())
    headerId Int @map("xtpg_envio_previsto_header_id")

    status       String  @default("ENVIADO") @map("status") @db.NVarChar(20) /// ENVIADO | ERRO
    idXrt        String? @map("id_xrt") @db.NVarChar(50) /// UUID retornado pela XTPG
    mensagemErro String? @map("mensagem_erro") @db.NVarChar(Max) /// Erro retornado pela XTPG p/ este registro

    // Chave de origem (rastreio e write-back futuro p/ saida.asmx)
    origemTabela   String? @map("origem_tabela") @db.NVarChar(50) /// coluna "Tabela" da view
    origemDocEntry String? @map("origem_doc_entry") @db.NVarChar(50) /// coluna "DocEntry" da view

    // Espelho do payload enviado ao XTPG (denormalizado p/ validação dos logs)
    pfjNome              String? @map("pfj_nome") @db.NVarChar(100)
    pfjCpf               String? @map("pfj_cpf") @db.NVarChar(50)
    banCodigo            String? @map("ban_codigo") @db.NVarChar(50)
    ageCodigo            String? @map("age_codigo") @db.NVarChar(50)
    cntCodigo            String? @map("cnt_codigo") @db.NVarChar(50)
    tdpCodigo            String? @map("tdp_codigo") @db.NVarChar(50)
    docPagador           String? @map("doc_pagador") @db.NVarChar(20)
    pfjCodigo            String? @map("pfj_codigo") @db.NVarChar(50)
    valorOriginal        String? @map("valor_original") @db.NVarChar(50)
    valor                String? @map("valor") @db.NVarChar(50)
    docOrigem            String? @map("doc_origem") @db.NVarChar(100)
    historico            String? @map("historico") @db.NVarChar(200)
    contaContabil        String? @map("conta_contabil") @db.NVarChar(50)
    origemSistema        String? @map("origem_sistema") @db.NVarChar(50)
    origemPk             String? @map("origem_pk") @db.NVarChar(50)
    mmiCodigo            String? @map("mmi_codigo") @db.NVarChar(50)
    informacoesContabeis String? @map("informacoes_contabeis") @db.NVarChar(50)
    dataCaixa            String? @map("data_caixa") @db.NVarChar(40)
    dataCompetencia      String? @map("data_competencia") @db.NVarChar(40)
    dataPagamento        String? @map("data_pagamento") @db.NVarChar(40)
    dff01                String? @map("dff01") @db.NVarChar(50)
    dff02                String? @map("dff02") @db.NVarChar(100)
    moedaCodigo          String? @map("moeda_codigo") @db.NVarChar(10)
    temperatura          String? @map("temperatura") @db.NVarChar(10)

    criadoEm     DateTime @default(now()) @map("criado_em")
    atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

    header XtpgEnvioPrevistoHeader @relation(fields: [headerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

    @@index([headerId])
    @@index([status])
    @@index([idXrt])
    @@map("xtpg_envio_previsto_detail")
}

