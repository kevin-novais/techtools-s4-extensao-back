    GLAccount String @db.NVarChar(30) @map("gl_account") /// Conta do Razão
    GLAccountName String @db.NVarChar(100) @map("gl_account_name") /// Descrição da Conta
    GLAccountECD String? @db.NVarChar(30) @map("gl_account_ecd") /// Conta Sped Contabil
    GLAccountCosif String? @db.NVarChar(30) @map("gl_account_cosif") /// Conta do Plano Cosif (usar Cadocs)
    GLContaPaiCosif String? @db.NVarChar(30) @map("gl_conta_pai_cosif") /// Conta Pai do Plano Cosif
    ItemFluxoDeCaixa String? @db.NVarChar(20) @map("item_fluxo_de_caixa") /// Item do Fluxo de Caixa
    GlAccountB1Xtpg String? @map("gl_account_b1_xtpg") @db.NVarChar(30) /// Conta contábil B1 (XTPG)
    XtpgAtivado Boolean? @map("xtpg_ativado") /// Conta ativa para classificação XTPG
    CentroCusto String? @db.NVarChar(20) @map("centro_custo") /// (DTZ-247) Centro de custo enviado ao S/4 no LCM
    CentroLucro String? @db.NVarChar(20) @map("centro_lucro") /// (DTZ-247) Centro de lucro enviado ao S/4 no LCM

