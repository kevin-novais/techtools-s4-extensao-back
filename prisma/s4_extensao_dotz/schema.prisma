    referenceDocumentType String @map("reference_document_type") @db.NVarChar(10) /// Equivale a registros_contabeis.ReferenceDocumentType
    isReversed            String @map("is_reversed") @db.NVarChar(1) /// Equivale a registros_contabeis.IsReversed
    reversalReason        String @map("reversal_reason") @db.NVarChar(2) /// Equivale a registros_contabeis.ReversalReason
    debitCreditCode       String @map("debit_credit_code") @db.NVarChar(1) /// Equivale a registros_contabeis.DebitCreditCode
