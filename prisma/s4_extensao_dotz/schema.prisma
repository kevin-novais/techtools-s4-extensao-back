// =====================================================================
// SAÍDA XTPG (DTZ-227): movimentos contábeis do XTPG -> LCM no S/4.
// 1 Header por PAR_CONTABIL (= 1 LCM). Status como ID textual + descrição
// (NÃO o ENUM E/P/S da Entrada). Ver DTZ-227_Saida_XTPG_LCM_S4.md.
// =====================================================================
model XtpgSaidaHeader {
    id Int @id(map: "PK_xtpg_saida_header") @default(autoincrement())

    ciaId       Int?    @map("cia_id") /// cia.id interno (quando resolvido)
    ciaSap      String  @map("cia_sap") @db.NVarChar(50) /// PFJ_CODIGO (origem)
    parContabil String  @map("parcontabil") @db.NVarChar(50)
    /// Chave anti-duplicidade = cia_sap + parcontabil
    chaveValidacao String @map("chave_validacao") @db.NVarChar(120)
    codigoSap   String? @map("codigo_sap") @db.NVarChar(50) /// nº do LCM gerado no S/4

    // Fila SAP (createJournalEntry)
    statusSap          String    @default("AGUARDANDO") @map("status_sap") @db.NVarChar(20) /// AGUARDANDO | INTEGRADO | ERRO
    descricaoSap       String?   @map("descricao_sap") @db.NVarChar(Max)
    dataIntegracaoSap  DateTime? @map("data_integracao_sap")
    requestSap         String?   @map("request_sap") @db.NVarChar(Max)
    responseSap        String?   @map("response_sap") @db.NVarChar(Max)

    // Fila XTPG (MudarStatusMovimentoParContabil)
    statusXtpg         String    @default("AGUARDANDO") @map("status_xtpg") @db.NVarChar(20) /// AGUARDANDO | INTEGRADO | ERRO
    descricaoXtpg      String?   @map("descricao_xtpg") @db.NVarChar(Max)
    dataIntegracaoXtpg DateTime? @map("data_integracao_xtpg")
    requestXtpg        String?   @map("request_xtpg") @db.NVarChar(Max)
    responseXtpg       String?   @map("response_xtpg") @db.NVarChar(Max)
    criticaXtpg        String?   @map("critica_xtpg") @db.NVarChar(250) /// devolvido ao XTPG (= codigo_sap no sucesso); código trunca em 250

    totalRegistros Int @default(0) @map("total_registros")

    criadoEm     DateTime @default(dbgenerated("sysdatetime()")) @map("criado_em")
    atualizadoEm DateTime @default(dbgenerated("sysdatetime()")) @updatedAt @map("atualizado_em")

    detalhes XtpgSaidaDetail[]

    @@index([chaveValidacao], map: "IX_xtpg_saida_header_chave")
    @@index([statusSap], map: "IX_xtpg_saida_header_ssap")
    @@index([statusXtpg], map: "IX_xtpg_saida_header_sxtpg")
    @@index([criadoEm], map: "IX_xtpg_saida_header_criado")
    @@map("xtpg_saida_header")
}

model XtpgSaidaDetail {
    id       Int @id(map: "PK_xtpg_saida_detail") @default(autoincrement())
    headerId Int @map("xtpg_saida_header_id")

    // Espelho dos campos do movimento (response XTPG) usados no LCM
    mvtContador      String? @map("mvt_contador") @db.NVarChar(50)
    contaContabil    String? @map("conta_contabil") @db.NVarChar(50) /// conta B1 (origem XTPG)
    contaContabilS4  String? @map("conta_contabil_s4") @db.NVarChar(30) /// conta S/4 resolvida (contas_contabeis.gl_account_b1_xtpg)
    creditoDebito    String? @map("credito_debito") @db.NVarChar(1)
    valor            String? @map("valor") @db.NVarChar(50)
    historico        String? @map("historico") @db.NVarChar(Max)
    indCodigo        String? @map("ind_codigo") @db.NVarChar(20) /// moeda de origem (ex.: BRA-BRL/BRL)
    banCodigo        String? @map("ban_codigo") @db.NVarChar(50)
    ageCodigo        String? @map("age_codigo") @db.NVarChar(50)
    cntCodigo        String? @map("cnt_codigo") @db.NVarChar(50)
    houseBank        String? @map("house_bank") @db.NVarChar(10) /// resolvido no de-para contas_bancarias
    houseBankAccount String? @map("house_bank_account") @db.NVarChar(20)

    criadoEm     DateTime @default(dbgenerated("sysdatetime()")) @map("criado_em")
    atualizadoEm DateTime @default(dbgenerated("sysdatetime()")) @updatedAt @map("atualizado_em")

    header XtpgSaidaHeader @relation(fields: [headerId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_xtpg_saida_detail_header")

    @@index([headerId], map: "IX_xtpg_saida_detail_header")
    @@map("xtpg_saida_detail")
}

