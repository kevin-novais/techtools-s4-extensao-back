// prisma/s4_extensao_dotz/schema.prisma
generator client {
    provider = "prisma-client-js"
    output   = "../../node_modules/@prisma/client-s4-dotz"
}

datasource db {
    provider = "sqlserver"
    url      = env("DATABASE_URL")
}

model Usuario {
    id                                       Int                           @id @default(autoincrement())
    email                                    String                        @unique
    nome                                     String
    senha                                    String
    perfil                                   String                        @default("USER")
    ativo                                    Boolean                       @default(true)
    avatarUrl                                String?
    atualizadoPor                            Int                           @map("atualizado_por")
    atualizadoEm                             DateTime                      @default(now()) @map("atualizado_em")
    tokensReset                              TokenResetSenha[]
    gruposUsuario                            UsuarioGrupoUsuario[]
    ciasAtualizadas                          Cia[]                         @relation("CiaAtualizadaPor")
    gruposUsuarioAtualizados                 GrupoUsuario[]                @relation("GrupoUsuarioAtualizadoPor")
    usuarioGruposAtualizados                 UsuarioGrupoUsuario[]         @relation("UsuarioGrupoAtualizadoPor")
    documentoFiscalHeadersAtualizados        DocumentoFiscalHeader[]       @relation("DocumentoFiscalHeaderAtualizadoPor")
    documentoFiscalHeadersCriados            DocumentoFiscalHeader[]       @relation("DocumentoFiscalHeaderCriadoPor")
    documentosFiscaisAprovados                DocumentoFiscalHeader[]       @relation("DocumentoFiscalHeaderAprovadoPor")
    configuracoesContabilAtualizadas         ConfiguracaoContabil[]        @relation("ConfiguracaoContabilAtualizadoPor")
    configuracoesContabilCriadas             ConfiguracaoContabil[]        @relation("ConfiguracaoContabilCriadoPor")
    configuracoesContabilDetalhesAtualizadas     ConfiguracaoContabilDetalhe[]     @relation("ConfiguracaoContabilDetalheAtualizadoPor")
    configuracoesContabilDetalhesCriadas         ConfiguracaoContabilDetalhe[]     @relation("ConfiguracaoContabilDetalheCriadoPor")
    configuracoesContabilDetalhesPontoAtualizadas ConfiguracaoContabilDetalhePonto[] @relation("ConfiguracaoContabilDetalhePontoAtualizadoPor")
    configuracoesContabilDetalhesPontoCriadas     ConfiguracaoContabilDetalhePonto[] @relation("ConfiguracaoContabilDetalhePontoCriadoPor")
    relatoriosCriados                        Relatorio[]                   @relation("RelatorioCriadoPor")
    relatoriosAtualizados                    Relatorio[]                   @relation("RelatorioAtualizadoPor")
    execucoesRelatorio                       RelatorioExecucaoLog[]        @relation("ExecucaoPor")
    fluxoCaixaCiaParceirosCriados            FluxoCaixaCiaParceiro[]       @relation("FluxoCaixaCiaParceiroCriadoPor")
    fluxoCaixaCiaParceirosAtualizados        FluxoCaixaCiaParceiro[]       @relation("FluxoCaixaCiaParceiroAtualizadoPor")
    fluxoCaixaCiaTipoLancamentosCriados      FluxoCaixaCiaTipoLancamento[] @relation("FluxoCaixaCiaTipoLancamentoCriadoPor")
    fluxoCaixaCiaTipoLancamentosAtualizados  FluxoCaixaCiaTipoLancamento[] @relation("FluxoCaixaCiaTipoLancamentoAtualizadoPor")

    @@index([nome, email])
    @@index([perfil])
    @@index([ativo])
    @@map("usuarios")
}

model TokenResetSenha {
    id        Int      @id @default(autoincrement())
    usuarioId Int      @map("usuario_id")
    token     String   @unique
    expiraEm  DateTime @map("expira_em")
    usado     Boolean  @default(false)
    criadoEm  DateTime @default(now()) @map("criado_em")

    usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

    @@index([token])
    @@index([usuarioId])
    @@index([expiraEm])
    @@index([usado])
    @@map("tokens_reset_senha")
}

model Cia {
    id            Int            @id @default(autoincrement())
    nome          String

    ciaIdSAP      String?        @map("cia_id_sap") @db.NVarChar(100)
    nomeBaseDadosB1 String?      @map("nome_base_dados_b1") @db.NVarChar(128)

    ie            String?        @map("ie") @db.NVarChar(9)
    endereco      String?        @map("endereco") @db.NVarChar(200)
    municipio     String?        @map("municipio") @db.NVarChar(100)
    uf            String?        @map("uf") @db.NVarChar(2)
    cep           String?        @map("cep") @db.NVarChar(8)
    bairro        String?        @map("bairro") @db.NVarChar(100)
    cpfCnpj       String?        @map("cpf_cnpj") @db.NVarChar(14)
    telefone      String?        @map("telefone") @db.NVarChar(20)

    atualizadoEm  DateTime       @default(now()) @map("atualizado_em")
    atualizadoPor Int            @map("atualizado_por")
    deletadoEm    DateTime?      @map("deletado_em")
    gruposUsuario GrupoUsuario[]

    atualizadoPorUsuario   Usuario                 @relation("CiaAtualizadaPor", fields: [atualizadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)
    documentoFiscalHeaders DocumentoFiscalHeader[]
    configuracoesContabil  ConfiguracaoContabil[]


    @@index([nome])
    @@index([atualizadoPor])
    @@index([deletadoEm])
    @@map("cia")
}

model GrupoUsuario {
    id                Int                   @id @default(autoincrement())
    ciaId             Int                   @map("cia_id")
    nome              String                @unique
    dataInicio        DateTime              @map("data_inicio") @db.Date
    dataFim           DateTime              @map("data_fim") @db.Date
    aprovaDivergencia Boolean               @map("aprova_divergencia")
    atualizadoEm      DateTime              @default(now()) @map("atualizado_em")
    atualizadoPor     Int                   @map("atualizado_por")
    deletadoEm        DateTime?             @map("deletado_em")
    usuarios          UsuarioGrupoUsuario[]

    cia                  Cia     @relation(fields: [ciaId], references: [id])
    atualizadoPorUsuario Usuario @relation("GrupoUsuarioAtualizadoPor", fields: [atualizadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)

    @@index([ciaId])
    @@index([ciaId, deletadoEm])
    @@index([dataInicio])
    @@index([dataFim])
    @@index([atualizadoPor])
    @@index([deletadoEm])
    @@map("grupo_usuario")
}

model UsuarioGrupoUsuario {
    usuarioId      Int      @map("usuario_id")
    grupoUsuarioId Int      @map("grupo_usuario_id")
    atualizadoEm   DateTime @default(now()) @map("atualizado_em")
    atualizadoPor  Int      @map("atualizado_por")

    usuario              Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
    grupoUsuario         GrupoUsuario @relation(fields: [grupoUsuarioId], references: [id], onDelete: Cascade)
    atualizadoPorUsuario Usuario      @relation("UsuarioGrupoAtualizadoPor", fields: [atualizadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)

    @@id([usuarioId, grupoUsuarioId])
    @@index([usuarioId])
    @@index([grupoUsuarioId])
    @@index([atualizadoPor])
    @@map("usuario_grupo_usuario")
}

/**
 * # Documento Fiscal Header
 * - CODIGO_FORNECEDOR_SAP ( Pegar a primera linha da coluna PEDIDO_PARCEIRO e  por esse número buscar no stage o Código do fornecedor SAP)
 * - CODIGO_FORNECEDOR_ ANALYZER: (Buscar na tabela OCRD depois que buscar o código do fornacedor SAP. validar se não na mesma tabela que vamos buscar o código SAP).
 * - CODIGO_DOCUMENTO ( Pegar a primera linha da coluna NFVENDA na planilha de romaneio)
 * - TipoDocumento: Valores permitidos: "ROMANEIO" | "POS" ( Padrão: "ROMANEIO" )
 * - TipoDocumentoERP: Preenchido pela configuração contábil. Campo de texto livre (máximo 20 caracteres)
 * - Status: Valores permitidos: AGUARDANDO, PROCESSANDO, ERRO_PROCESSAMENTO, APROVADO, REPROVADO, DIVERGENCIA, INTEGRADO, ERRO_INTEGRACAO. ( Padrão: "AGUARDANDO" ).
 * - DATA_EMISSAO: O usuário deve informar a data de emissão do documento fiscal.
 * - DATA_LANCAMENTO_CONTABIL: O usuário deve informar a data de lançamento contábil do documento fiscal.
 */

model DocumentoFiscalHeader {
    id                       Int    @id @default(autoincrement()) @map("id")
    ciaId                    Int    @map("cia_id")
    codigoFornecedorSAP      String? @map("codigo_fornecedor_sap")
    codigoFornecedorAnalyzer String? @map("codigo_fornecedor_analyzer")
    codigoDocumento          String @map("codigo_documento") @db.NVarChar(100)
    tipoDocumentoERP         String @default("TP_ROM") @map("tipo_documento_erp")
    tipoContabilERP          String? @map("tipo_contabil_erp") @db.VarChar(20)
    codigoDocumentoERP       String? @map("codigo_documento_erp") @db.NVarChar(20) /// Vem da integração com o SAP
    status                   String @default("AGUARDANDO") @map("status") @db.NVarChar(30)
    romaneioUrl              String? @map("romaneio_url") /// Opcional: Romaneio tem arquivo XLSX, POS não tem arquivo de origem. Path relativo no storage.
    romaneioFileName         String? @map("romaneio_file_name") @db.NVarChar(255) /// Nome do arquivo tratado (sem caracteres inválidos p/ URL) + hash de deduplicação; usado para montar a URL pública de anexo enviada ao SAP
    nomeRomaneio             String? @map("nome_romaneio") @db.NVarChar(255) /// Nome original do arquivo de romaneio de origem (exibição): um arquivo gera um header por código de documento (NFVENDA)

    observacoesRomaneio      String? @map("observacoes_romaneio") @db.NVarChar(Max) /// Vai ser utilizado para armazenar observações do romaneio quando forem aprovados ou reprovados
    dataAprovacaoRomaneio    DateTime? @map("data_aprovacao_romaneio") @db.Date /// Data de aprovação do romaneio quando forem aprovados ou reprovados
    aprovadoPorUsuarioId     Int? @map("aprovado_por_usuario_id") /// Id do usuário que aprovou o romaneio quando forem aprovados ou reprovados
    aprovadoPorUsuario Usuario? @relation("DocumentoFiscalHeaderAprovadoPor", fields: [aprovadoPorUsuarioId], references: [id], onDelete: NoAction, onUpdate: NoAction)


    dataEmissao            DateTime  @map("data_emissao") @db.Date
    dataLancamentoContabil DateTime  @map("data_lancamento_contabil") @db.Date
    ano                    Int       @default(dbgenerated("datepart(year,getdate())")) @map("ano")
    dataVencimento         DateTime?  @map("data_vencimento") @db.Date
    dataProcessamentoInicio DateTime? @map("data_processamento_inicio")
    dataProcessamentoFim    DateTime? @map("data_processamento_fim")
    dataIntegracao         DateTime? @map("data_integracao")

    quantidadeTotalPedidos Int? @map("quantidade_total_pedidos")

    valorTotalProdutos Decimal? @map("valor_total_produtos") @db.Decimal(19,2) /// Valor total dos produtos (Vem no arquivo Romaneio xlsx no campo VLPROD) Vai ter que somar o valor de todos os produtos
    valorTotalPedido Decimal? @map("valor_total_pedido") @db.Decimal(19,2) /// Valor total do pedido (Vem no arquivo Romaneio xlsx no campo VLRPEDIDO) Vai ter que somar o valor de todos os pedidos
    valorTotalFrete Decimal? @map("valor_total_frete") @db.Decimal(19,2) /// Valor total do frete (Vem no arquivo Romaneio xlsx no campo VLFRETE) Vai ter que somar o valor de todos os fretes
    valorTotalCombo Decimal? @map("valor_total_combo") @db.Decimal(19,2) /// Valor total dos combos (Vem no arquivo Romaneio xlsx no campo VLCOMBO) Vai ter que somar o valor de todos os combos

    valorTotalProdutosAnalyzer Decimal? @map("valor_total_produtos_analyzer") @db.Decimal(19,2) /// Valor total dos produtos no analyzer
    valorTotalPedidoAnalyzer Decimal? @map("valor_total_pedido_analyzer") @db.Decimal(19,2) /// Valor total do pedido no analyzer
    valorTotalFreteAnalyzer Decimal? @map("valor_total_frete_analyzer") @db.Decimal(19,2) /// Valor total do frete no analyzer
    valorTotalComboAnalyzer Decimal? @map("valor_total_combo_analyzer") @db.Decimal(19,2) /// Valor total dos combos no analyzer

    valorTotalIs Decimal? @map("valor_total_is") @db.Decimal(19,2)
    valorTotalCbs Decimal? @map("valor_total_cbs") @db.Decimal(19,2)
    valorTotalIbsUf Decimal? @map("valor_total_ibs_uf") @db.Decimal(19,2)
    valorTotalIbsMunicipal Decimal? @map("valor_total_ibs_municipal") @db.Decimal(19,2)


    filtrosPosJson String? @map("filtros_pos_json") @db.NVarChar(Max) /// JSON dos filtros usados na criação do documento POS (para reprocessamento)

    documentoJson String? @map("documento_json") @db.NVarChar(Max) /// JSON do envelope de envio ao SAP (createJournalEntry): ver payloadEnvioSap na API

    posRelatorioPdfUrl String? @map("pos_relatorio_pdf_url") @db.NVarChar(1000) /// Path relativo no storage do relatório PDF gerado para o POS
    posRelatorioPdfFileName String? @map("pos_relatorio_pdf_file_name") @db.NVarChar(255) /// Nome do arquivo tratado + hash; usado para montar a URL pública de anexo enviada ao SAP
    posRelatorioXlsxUrl String? @map("pos_relatorio_xlsx_url") @db.NVarChar(1000) /// Path relativo no storage do relatório XLSX gerado para o POS
    posRelatorioXlsxFileName String? @map("pos_relatorio_xlsx_file_name") @db.NVarChar(255) /// Nome do arquivo tratado + hash; usado para montar a URL pública de anexo enviada ao SAP

    retornoIntegracaoSap String? @map("retorno_integracao_sap") @db.NVarChar(Max) /// JSON do retorno da integração SAP (createJournalEntry): status, corpo da API e metadados

    criadoPor     Int      @map("criado_por")
    criadoEm      DateTime @default(now()) @map("criado_em")
    atualizadoPor Int      @map("atualizado_por")
    atualizadoEm  DateTime @default(now()) @map("atualizado_em")
    

    cia                  Cia                   @relation(fields: [ciaId], references: [id])
    atualizadoPorUsuario Usuario               @relation("DocumentoFiscalHeaderAtualizadoPor", fields: [atualizadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)
    criadoPorUsuario     Usuario               @relation("DocumentoFiscalHeaderCriadoPor", fields: [criadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)

    documentoFiscalDetalhes DocumentoFiscalDetalhe[]
    documentoFiscalPontos   DocumentoFiscalPonto[]

    @@unique([ciaId, codigoDocumento, tipoDocumentoERP])
    @@index([ciaId])
    @@index([codigoFornecedorSAP])
    @@index([codigoFornecedorAnalyzer])
    @@index([codigoDocumento])
    @@index([ciaId, ano])
    @@index([criadoPor])
    @@index([criadoEm])
    @@index([atualizadoPor])
    @@index([atualizadoEm])
    @@map("documento_fiscal_header")
}


model DocumentoFiscalDetalhe {
    id                       Int    @id @default(autoincrement()) @map("id")
    documentoFiscalHeaderId  Int    @map("documento_fiscal_header_id")
    codigoDocumento          String @map("codigo_documento") @db.NVarChar(100)
    codigoFornecedorSAP      String? @map("codigo_fornecedor_sap") @db.NVarChar(50) /// Código do fornecedor SAP do pedido (Vem do pedidoAnalyzer.CardCode)
    codigoDocumentoERP         String? @map("codigo_documento_erp") @db.NVarChar(20) /// Vem da integração com o SAP)

    itemDocumento Int? @map("item_documento") /// Sequêncial com ordem do pedido dentro do romaneio
    codigoProdutoDotz String? @map("codigo_produto_dotz") @db.NVarChar(20) // Vem da  tabela OITM.itemCode
    codigoProdutoFornecedor String? @map("codigo_produto_fornecedor") @db.NVarChar(17)  // Vem da tabela OITM.SuppCatNum
    codigoProdutoRomaneio String? @map("codigo_produto_romaneio") @db.NVarChar(20) // Vem da tabela Romaneio xlsx no campo PRODUTO


    quantidadeProduto Int? @map("quantidade_produto_romaneio") /// Quantidade do produto (Vem no arquivo Romaneio xlsx no campo QTDPROD)
    descricaoProduto String? @map("descricao_produto_romaneio") /// Descrição do produto (Vem no arquivo Romaneio xlsx no campo DESCRICAO)
    valorProduto Decimal? @map("valor_produto_romaneio") @db.Decimal(19,2) /// Valor do produto (Vem no arquivo Romaneio xlsx no campo VLPROD)
    valorPedido Decimal? @map("valor_pedido_romaneio") @db.Decimal(19,2) /// Valor do pedido (Vem no arquivo Romaneio xlsx no campo VLRPEDIDO)
    valorFrete Decimal? @map("valor_frete_romaneio") @db.Decimal(19,2) /// Valor do frete (Vem no arquivo Romaneio xlsx no campo VLFRETE)
    valorCombo Decimal? @map("valor_combo_romaneio") @db.Decimal(19,2) /// Valor do combo (Vem no arquivo Romaneio xlsx no campo COMBO)

    codigoPedidoParceiro String? @map("codigo_pedido_parceiro") @db.NVarChar(50) /// Pedido do parceiro (Vem no arquivo Romaneio xlsx no campo PEDIDO_PARCEIRO)
    codigoPedidoAnalyzer String? @map("codigo_pedido_analyzer") @db.NVarChar(50) /// DocEntry do pedido (Vem da tabela OPOR do Analyzer)

    divergencias Boolean? @map("divergencias") @default(false) /// Divergências do detalhe do documento fiscal

    grupoPisCofins         String? @map("grupo_pis_cofins") @db.NVarChar(1) // Grupo PIS/COFINS (Vem da tabela OITM.OITM.U_Seidor_PC_Calcula 1 = S, 2 = N ou null)
    
    configuracaoContabilDetalheId Int? @map("configuracao_contabil_detalhe_id")

    configuracaoContabilDetalhe ConfiguracaoContabilDetalhe? @relation(fields: [configuracaoContabilDetalheId], references: [id], onDelete: NoAction, onUpdate: NoAction)

    // Processo Configuracao Contabil

    contaContabilCreditoCusto String? @map("conta_contabil_credito_custo") @db.NVarChar(20) /// Vem da tabela ConfiguracaoContabilDetalhe.contaCreditoValorProduto
    contaContabilDebitoCusto String? @map("conta_contabil_debito_custo") @db.NVarChar(20) /// Vem da tabela ConfiguracaoContabilDetalhe.contaDebitoValorProduto

    contaContabilCreditoFrete String? @map("conta_contabil_credito_frete") @db.NVarChar(20) /// Vem da tabela ConfiguracaoContabilDetalhe.contaCreditoValorFrete
    contaContabilDebitoFrete String? @map("conta_contabil_debito_frete") @db.NVarChar(20) /// Vem da tabela ConfiguracaoContabilDetalhe.contaDebitoValorFrete

    contaContabilCreditoCombo String? @map("conta_contabil_credito_combo") @db.NVarChar(20) /// Vem da tabela ConfiguracaoContabilDetalhe.contaCreditoValorCombo
    contaContabilDebitoCombo String? @map("conta_contabil_debito_combo") @db.NVarChar(20) /// Vem da tabela ConfiguracaoContabilDetalhe.contaDebitoValorCombo

    contaContabilCreditoPis String? @map("conta_contabil_credito_pis") @db.NVarChar(20) /// Vem da tabela ConfiguracaoContabilDetalhe.contaCreditoPis
    contaContabilDebitoPis String? @map("conta_contabil_debito_pis") @db.NVarChar(20) /// Vem da tabela ConfiguracaoContabilDetalhe.contaDebitoPis

    contaContabilCreditoCofins String? @map("conta_contabil_credito_cofins") @db.NVarChar(20) /// Vem da tabela ConfiguracaoContabilDetalhe.contaCreditoCofins
    contaContabilDebitoCofins String? @map("conta_contabil_debito_cofins") @db.NVarChar(20) /// Vem da tabela ConfiguracaoContabilDetalhe.contaDebitoCofins

    contaContabilCreditoValorIs String? @map("conta_contabil_credito_valor_is") @db.NVarChar(20) /// Vem da tabela ConfiguracaoContabilDetalhe.contaCreditoValorIs
    contaContabilDebitoValorIs String? @map("conta_contabil_debito_valor_is") @db.NVarChar(20) /// Vem da tabela ConfiguracaoContabilDetalhe.contaDebitoValorIs

    contaContabilCreditoValorCbs String? @map("conta_contabil_credito_valor_cbs") @db.NVarChar(20) /// Vem da tabela ConfiguracaoContabilDetalhe.contaCreditoValorCbs
    contaContabilDebitoValorCbs String? @map("conta_contabil_debito_valor_cbs") @db.NVarChar(20) /// Vem da tabela ConfiguracaoContabilDetalhe.contaDebitoValorCbs

    contaContabilCreditoValorIbsUf String? @map("conta_contabil_credito_valor_ibs_uf") @db.NVarChar(20) /// Vem da tabela ConfiguracaoContabilDetalhe.contaCreditoValorIbsUf
    contaContabilDebitoValorIbsUf String? @map("conta_contabil_debito_valor_ibs_uf") @db.NVarChar(20) /// Vem da tabela ConfiguracaoContabilDetalhe.contaDebitoValorIbsUf
    
    contaContabilCreditoValorIbsMunicipal String? @map("conta_contabil_credito_valor_ibs_municipal") @db.NVarChar(20) /// Vem da tabela ConfiguracaoContabilDetalhe.contaCreditoValorIbsMunicipal
    contaContabilDebitoValorIbsMunicipal String? @map("conta_contabil_debito_valor_ibs_municipal") @db.NVarChar(20) /// Vem da tabela ConfiguracaoContabilDetalhe.contaDebitoValorIbsMunicipal

    centroCusto String? @map("centro_custo") @db.NVarChar(20) /// Vem da tabela ConfiguracaoContabilDetalhe.centroCusto
    centroLucro String? @map("centro_lucro") @db.NVarChar(20) /// Vem da tabela ConfiguracaoContabilDetalhe.centroLucro

    valorPisOperacaoCredor Decimal? @map("valor_pis_operacao_credor") @db.Decimal(19,2) /// VALOR_PEDIDO_ROMANEIO * ConfiguracaoContabilDetalhe.aliquotaPis / 100
    valorCofinsOperacaoCredor Decimal? @map("valor_cofins_operacao_credor") @db.Decimal(19,2) /// VALOR_PEDIDO_ROMANEIO * ConfiguracaoContabilDetalhe.aliquotaCofins / 100

    valorIs Decimal? @map("valor_is") @db.Decimal(19,2) /// Não sabemos ainda
    valorCbs Decimal? @map("valor_cbs") @db.Decimal(19,2) /// Não sabemos ainda
    valorIbsUf Decimal? @map("valor_ibs_uf") @db.Decimal(19,2) /// Não sabemos ainda
    valorIbsMunicipal Decimal? @map("valor_ibs_municipal") @db.Decimal(19,2) /// Não sabemos ainda

    criadoEm DateTime @default(now()) @map("criado_em")

    atualizadoEm DateTime? @default(now()) @map("atualizado_em")

    documentoFiscalHeader DocumentoFiscalHeader @relation(fields: [documentoFiscalHeaderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

    documentoFiscalErrors DocumentoFiscalErrors[]
    

    @@index([documentoFiscalHeaderId])
    @@index([codigoDocumento])
    @@index([codigoPedidoParceiro])
    @@index([codigoPedidoAnalyzer], map: "IX_documento_fiscal_detail_pedido_analyzer")
    @@index([codigoFornecedorSAP])
    @@map("documento_fiscal_detail")
}


/// Log/snapshot das configurações contábeis de PONTO usadas no cálculo enviado ao SAP
/// numa troca (DTZ-297). Congela, por documento fiscal, as linhas de
/// `configuracao_contabil_detail_ponto` que foram aplicadas. Os ids de configuração são
/// gravados como VALOR (sem FK) para o histórico não quebrar quando a config muda/é apagada;
/// a única FK é o documento fiscal a que o log pertence (Cascade).
model DocumentoFiscalPonto {
    id                      Int @id @default(autoincrement()) @map("id")
    documentoFiscalHeaderId Int @map("documento_fiscal_header_id")

    /// Snapshot: id do header de configuração contábil aplicado (valor, sem FK).
    configuracaoContabilHeaderId       Int  @map("configuracao_contabil_header_id")
    /// Snapshot: id da linha de origem em configuracao_contabil_detail_ponto (rastreio; valor, sem FK).
    configuracaoContabilDetalhePontoId Int? @map("configuracao_contabil_detalhe_ponto_id")

    /// @REFDOTZ.U_TIPO cru que resolveu a config (antes do fallback p/ default). O relatório de Trocas
    /// junta por (documento_fiscal_header_id, u_tipo), então precisa do tipo original, não do resolvido.
    uTipo          String?  @map("u_tipo") @db.NVarChar(20)
    codigoPonto    String?  @map("codigo_ponto") @db.NVarChar(20) /// Código da config aplicada (já resolvido: o do U_TIPO ou o default). Null = regra p/ todos os pontos
    descricaoPonto String?  @map("descricao_ponto") @db.NVarChar(250)
    custoPonto     Decimal? @map("custo_ponto") @db.Decimal(19, 6) /// Mesma precisão da origem (evita truncar o custo do snapshot)

    contaCredito String? @map("conta_credito") @db.NVarChar(20) /// Conta contábil SAP - crédito
    contaDebito  String? @map("conta_debito") @db.NVarChar(20) /// Conta contábil SAP - débito

    grupoPisCofins String @default("N") @map("grupo_pis_cofins") @db.NVarChar(1) /// 'S'/'N' (mesmo domínio da origem)

    aliquotaPis        Decimal? @map("aliquota_pis") @db.Decimal(7, 4)
    contaCreditoPis    String?  @map("conta_credito_pis") @db.NVarChar(20)
    contaDebitoPis     String?  @map("conta_debito_pis") @db.NVarChar(20)

    aliquotaCofins     Decimal? @map("aliquota_cofins") @db.Decimal(7, 4)
    contaCreditoCofins String?  @map("conta_credito_cofins") @db.NVarChar(20)
    contaDebitoCofins  String?  @map("conta_debito_cofins") @db.NVarChar(20)

    criadoEm DateTime @default(now()) @map("criado_em")

    documentoFiscalHeader DocumentoFiscalHeader @relation(fields: [documentoFiscalHeaderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

    @@index([documentoFiscalHeaderId])
    @@index([documentoFiscalHeaderId, uTipo]) /// JOIN do relatório de Trocas (por documento + tipo cru)
    @@index([configuracaoContabilHeaderId])
    @@index([codigoPonto])
    @@index([criadoEm])
    @@map("documento_fiscal_ponto")
}


/**
 * # Documento Fiscal Errors
 * 
 * Armazena os erros de validação encontrados durante o processamento de documentos fiscais.
 * 
 * ## Tipos de Erro
 * 
 * O campo `tipo` identifica a categoria do erro:
 * - `DIVERGENCIA`: Diferença entre dados do romaneio e do Analyzer (não impede integração)
 * - `ERRO`: Erro crítico de validação (impede integração)
 * 
 * **Tipagem TypeScript**: Para garantir type-safety no código, utilize a tipagem:
 * `src/@types/DocumentoFiscalError/TipoErroTypes.ts`
 * 
 * ## Códigos de Erro
 * 
 * O campo `code` armazena códigos de erro de validação que identificam o tipo de problema encontrado.
 * Para consultar a lista completa de códigos e suas descrições, consulte:
 * `src/modules/documento-fiscal/documento-details/services/processamento/utils/errorCodes.ts`
 */
model DocumentoFiscalErrors {
    id                       Int    @id @default(autoincrement()) @map("id")
    documentoFiscalDetalheId Int    @map("documento_fiscal_detalhe_id")
    tipo String? @map("tipo") @default("DIVERGENCIA") @db.NVarChar(20)
    code String? @map("code") @db.NVarChar(50)
    mensagem String? @map("mensagem") @db.NVarChar(Max) // Detalhes do erro

    criadoEm DateTime @default(now()) @map("criado_em")

    documentoFiscalDetalhe DocumentoFiscalDetalhe @relation(fields: [documentoFiscalDetalheId], references: [id], onDelete: Cascade, onUpdate: NoAction)


    @@map("documento_fiscal_error")
}

/**
 * # Configuração Contábil
 * - TipoDocumentoERP: Valores permitidos: TP_ROM(Troca de pontos Romaneio) | TP_POS(Troca de pontos POS) | DR(Venda de pontos) | PD(Promo Dotz) | RD(Receitas Diferidas)
 * - GrupoPisCofins: Valores permitidos: S(Sim) | N(Não)
 * - TipoContabilERP: Campo de texto livre (máximo 20 caracteres, obrigatório)
 * - TextoHeaderContábil: opcional, máximo 25 caracteres
 */

model ConfiguracaoContabil {
    id                   Int     @id @default(autoincrement())
    tipoProcesso         String  @default("TP_ROM") @map("tipo_processo") @db.NVarChar(10)
    tipoDocumentoERP     String  @map("tipo_documento_erp") @db.NVarChar(2) /// Tipo de documento SAP (RE, PD, DR, RD)
    ciaId                Int     @map("cia_id")
    periodoDeDiferimento Int?    @map("periodo_de_diferimento")
    tipoContabilERP      String  @map("tipo_contabil_erp") @db.VarChar(20)
    textoHeaderContabil  String? @map("texto_header_contabil") @db.NVarChar(25) /// Texto exibido no header contábil (máx. 25 caracteres)
    tipoDocumentoXTPG    String? @map("tipo_documento_xtpg") @db.NVarChar(10) /// Tipo de documento enviado para XTPG — usado na chave de busca do boleto (S4P#Cia#Ano#Doc#TipoXTPG#Parceiro). Apenas para tipoProcesso=DR
    taxaExpiracao        Decimal? @map("taxa_expiracao") @db.Decimal(7, 4)

    criadoPor     Int      @map("criado_por")
    criadoEm      DateTime @default(now()) @map("criado_em")
    atualizadoPor Int      @map("atualizado_por")
    atualizadoEm  DateTime @default(now()) @map("atualizado_em")

    cia                  Cia     @relation(fields: [ciaId], references: [id])
    atualizadoPorUsuario Usuario @relation("ConfiguracaoContabilAtualizadoPor", fields: [atualizadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)
    criadoPorUsuario     Usuario @relation("ConfiguracaoContabilCriadoPor", fields: [criadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)

    configuracaoContabilDetalhes      ConfiguracaoContabilDetalhe[]
    configuracaoContabilDetalhesPonto ConfiguracaoContabilDetalhePonto[]

    @@unique([ciaId, tipoProcesso])
    @@index([ciaId])
    @@index([tipoProcesso])
    @@index([criadoPor])
    @@index([criadoEm])
    @@index([atualizadoPor])
    @@index([atualizadoEm])
    @@map("configuracao_contabil_header")
}

