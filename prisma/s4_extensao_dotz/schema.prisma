model FluxoCaixaCiaParceiro {
    cardCode       String   @map("card_code") @db.NVarChar(50) /// Código do Fornecedor
    companyCode    String   @map("company_code") @db.NVarChar(10) /// Código da CIA
    itemFluxoCaixa String   @map("item_fluxo_caixa") @db.NVarChar(20) /// Item do Fluxo de Caixa

    criadoEm      DateTime @default(now()) @map("criado_em")
    atualizadoEm  DateTime @default(now()) @updatedAt @map("atualizado_em")
