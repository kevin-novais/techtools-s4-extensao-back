model Relatorio {
    id              Int      @id @default(autoincrement())
    nome            String   @db.VarChar(200)
    descricao       String?  @db.VarChar(500)
    grupo           String?  @db.VarChar(100)
    query           String   @db.VarChar(Max)
    criadoPorId     Int      @map("criado_por")
    criadoEm        DateTime @default(now()) @map("criado_em")
    atualizadoPorId Int?     @map("atualizado_por")
    atualizadoEm    DateTime @updatedAt @map("atualizado_em")

    criadoPor     Usuario              @relation("RelatorioCriadoPor", fields: [criadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    atualizadoPor Usuario?             @relation("RelatorioAtualizadoPor", fields: [atualizadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    execucoes     RelatorioExecucaoLog[]
    variaveis     RelatorioVariavel[]

    @@index([criadoPorId])
    @@index([criadoEm])
    @@index([grupo])
    @@map("relatorio")
}

model RelatorioVariavel {
    id          Int                   @id @default(autoincrement())
    relatorioId Int                   @map("relatorio_id")
    chave       String                @db.VarChar(50)
    label       String                @db.VarChar(100)
    tipo              String  @db.VarChar(10)
    obrigatorio       Boolean @default(true)
    fusoHorarioBrasil Boolean @default(false) @map("fuso_horario_brasil")
    ordem             Int     @default(0)

    relatorio Relatorio @relation(fields: [relatorioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

    @@unique([relatorioId, chave])
    @@index([relatorioId])
    @@map("relatorio_variavel")
}

model RelatorioExecucaoLog {
    id             Int      @id @default(autoincrement())
    relatorioId    Int      @map("relatorio_id")
    executadoPorId Int      @map("executado_por")
    executadoEm    DateTime @default(now()) @map("executado_em")
    duracaoMs      Int      @map("duracao_ms")
    totalLinhas    Int?     @map("total_linhas")
    status         String   @db.VarChar(10) @map("status")
    mensagemErro   String?  @db.VarChar(Max) @map("mensagem_erro")

    relatorio    Relatorio @relation(fields: [relatorioId], references: [id], onDelete: Cascade, onUpdate: NoAction)
    executadoPor Usuario   @relation("ExecucaoPor", fields: [executadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

    @@index([relatorioId])
    @@index([executadoPorId])
    @@index([executadoEm])
    @@map("relatorio_execucao_log")
}

