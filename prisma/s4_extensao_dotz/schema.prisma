    atualizadoPor Int      @map("atualizado_por")

    criadoPorUsuario     Usuario @relation("FluxoCaixaCiaParceiroCriadoPor", fields: [criadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)
    atualizadoPorUsuario Usuario @relation("FluxoCaixaCiaParceiroAtualizadoPor", fields: [atualizadoPor], references: [id], onDelete: NoAction, onUpdate: NoAction)

